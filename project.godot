; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Mad Santa"
run/main_scene="res://Scenes/main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="res://Resources/default_bus_layout.tres"

[autoload]

Namegenerator="*res://Scripts/Autoload/Namegenerator.gd"
Globals="*res://Scripts/Autoload/Globals.gd"
Texts="*res://Scripts/Autoload/Texts.gd"
Save="*res://Scripts/Autoload/Save.gd"
State="*res://Scripts/Autoload/State.gd"
Upgrades="*res://Scripts/Autoload/Upgrades.gd"
Localization="*res://Scripts/Autoload/Localization.gd"
SignalBus="*res://Scripts/Autoload/SignalBus.gd"

[display]

window/size/initial_position_type=3
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_height"

[editor_plugins]

enabled=PackedStringArray("res://addons/ridiculous_coding/plugin.cfg")

[file_customization]

folder_colors={
"res://Resources/": "blue",
"res://Resources/Fonts/": "red",
"res://Resources/Images/": "purple",
"res://Resources/Shaders/": "pink",
"res://Resources/Sounds/": "yellow",
"res://Scenes/": "orange",
"res://Scenes/Levels/": "orange",
"res://Scripts/": "green",
"res://Scripts/Level/": "orange",
"res://Translations/": "red"
}

[global_group]

Translated="Contains every Control SubNode that will be translated"
TranslatedContainer="Translates every child node"

[gui]

theme/default_font_multichannel_signed_distance_field=true

